generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum MembershipRole {
  ADMIN
  BUYER
  SUPPLIER
  SELLER
}

enum UserStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum CompanyType {
  BUYER
  SUPPLIER
  HYBRID
}

// Rol comercial del proveedor: fija expectativas de minimos y flexibilidad
// tecnica (fabricante = adapta pero pide mas cantidad; distribuidor = stock
// rapido; representante = comercializa marcas de terceros).
enum SupplierRole {
  MANUFACTURER
  DISTRIBUTOR
  INTEGRATOR
  REPRESENTATIVE
}

enum RequestStatus {
  DRAFT
  PUBLISHED
  REVIEWING
  AWARDED
  NEGOTIATING
  ORDER_ISSUED
  COMPLETED
  CANCELLED
}

enum QuoteStatus {
  DRAFT
  SUBMITTED
  AWARDED
  REJECTED
  WITHDRAWN
}

enum RequestEventType {
  REQUEST_CREATED
  QUOTE_SUBMITTED
  QUOTE_UPDATED
  REQUEST_AWARDED
  NEGOTIATION_STARTED
  ORDER_ISSUED
  ORDER_UPDATED
  ORDER_CONFIRMED
  PRODUCTION_STARTED
  ORDER_DISPATCHED
  ORDER_DELIVERED
  REQUEST_COMPLETED
  REQUEST_CANCELLED
}

enum OrderFulfillmentStatus {
  ISSUED
  CONFIRMED
  IN_PRODUCTION
  DISPATCHED
  DELIVERED
}

enum ConversationContextType {
  PRODUCT
  REQUEST
  QUOTE
}

// Estado comercial de una solicitud dentro de una empresa proveedora.
// Es independiente del estado de la solicitud (que pertenece al comprador):
// una misma solicitud puede estar GANADA para un proveedor y PERDIDA para otro.
enum OpportunityStatus {
  NEW
  UNASSIGNED
  ASSIGNED
  IN_RESPONSE
  QUOTED
  NEGOTIATING
  WON
  LOST
}

// Quien inicio el vinculo entre un vendedor y una empresa proveedora.
// El vendedor puede ofrecerse a representar una empresa, y la empresa puede
// invitar a un vendedor a su equipo. El flujo de respuesta es el mismo.
enum RepresentationDirection {
  SELLER_TO_COMPANY
  COMPANY_TO_SELLER
}

enum RepresentationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum NotificationType {
  QUOTE_SUBMITTED
  QUOTE_UPDATED
  QUOTE_AWARDED
  QUOTE_REJECTED
  NEGOTIATION_STARTED
  ORDER_ISSUED
  ORDER_UPDATED
  FULFILLMENT_UPDATED
  NEW_MESSAGE
  REQUEST_ASSIGNED
  REQUEST_REASSIGNED
  REQUEST_UPDATED
  REQUEST_RECEIVED
  REPRESENTATION_REQUESTED
  REPRESENTATION_ACCEPTED
  REPRESENTATION_REJECTED
  REPRESENTATION_CANCELLED
  REQUEST_COMPLETED
  REQUEST_CANCELLED
  BILLING_SETTLEMENT_ISSUED
  BILLING_SETTLEMENT_DUE_SOON
  BILLING_SETTLEMENT_OVERDUE
  BILLING_PAYMENT_CONFIRMED
  BILLING_PAYMENT_REJECTED
}

enum NotificationEmailStatus {
  PENDING
  SENT
  SKIPPED
  FAILED
}

enum PushChannel {
  WEB
  MOBILE_EXPO
}

enum RequestCatalogFieldType {
  CHOICES
  SEGMENTED
  INPUT
  QUANTITY
  UPLOADER
  TEXTAREA
}

enum RequestCatalogInputType {
  TEXT
  DATE
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  firstName    String
  lastName     String
  status       UserStatus   @default(ACTIVE)
  memberships  Membership[]
  notifications Notification[]
  pushEndpoints PushEndpoint[]
  assignedRequests  RequestAssignment[] @relation("SellerAssignments")
  assignmentsMade   RequestAssignment[] @relation("AssignedByUser")
  representationRequests  RepresentationRequest[] @relation("SellerRepresentation")
  representationRequestsSent RepresentationRequest[] @relation("RepresentationCreatedBy")
  representationRequestsAnswered RepresentationRequest[] @relation("RepresentationRespondedBy")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Company {
  id              String          @id @default(cuid())
  name            String
  /** Razon social (puede diferir del nombre de fantasia). */
  legalName       String?
  /** CUIT (sin formato o con guiones, segun lo cargue el usuario). */
  taxId           String?
  /** Condicion frente al IVA: Responsable Inscripto / Monotributo / Exento. */
  taxCondition    String?
  /** Logo de la empresa. Vive aca y no en SupplierProfile porque tambien lo
      usan las compradoras (chat, selector de empresa, listados). */
  logoUrl         String?
  type            CompanyType
  country         String          @default("AR")
  city            String?
  memberships     Membership[]
  supplierProfile SupplierProfile?
  requests        Request[]       @relation("BuyerRequests")
  quotes          Quote[]         @relation("SupplierQuotes")
  requestAssignments RequestAssignment[] @relation("SupplierAssignments")
  requestTargets  RequestTargetSupplier[] @relation("RequestTargets")
  representationRequests RepresentationRequest[]
  billingCommissions BillingCommission[]
  billingSettlements BillingSettlement[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Membership {
  id         String         @id @default(cuid())
  userId     String
  companyId  String
  role       MembershipRole
  isPrimary  Boolean        @default(false)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())

  @@unique([userId, companyId, role])
  @@index([companyId])
  @@index([userId])
}

// Pedido para que un vendedor represente a una empresa proveedora.
//
// Sirve para los dos sentidos: el vendedor se ofrece (SELLER_TO_COMPANY) o la
// empresa lo invita (COMPANY_TO_SELLER). Cuando se acepta se crea la
// Membership con rol SELLER; hasta entonces el vendedor no ve nada de la
// empresa. Solo puede haber un pedido PENDING por (empresa, vendedor).
model RepresentationRequest {
  id                String                  @id @default(cuid())
  companyId         String
  sellerUserId      String
  direction         RepresentationDirection
  status            RepresentationStatus    @default(PENDING)
  message           String?
  createdByUserId   String
  respondedByUserId String?
  respondedAt       DateTime?
  company           Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  seller            User                    @relation("SellerRepresentation", fields: [sellerUserId], references: [id], onDelete: Cascade)
  createdBy         User                    @relation("RepresentationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  respondedBy       User?                   @relation("RepresentationRespondedBy", fields: [respondedByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  // Un solo vinculo vivo por par: si el pedido se rechaza y mas adelante se
  // vuelve a intentar, se reusa la misma fila en vez de acumular duplicados.
  @@unique([companyId, sellerUserId])
  @@index([companyId, status])
  @@index([sellerUserId, status])
}

// Ficha publica de una empresa proveedora: lo que ve un comprador antes de
// pedirle una cotizacion. No guarda telefono ni mail a proposito: el contacto
// pasa por el chat interno de la plataforma, que deja registro de la
// conversacion asociada a la solicitud.
model SupplierProfile {
  id               String   @id @default(cuid())
  companyId        String   @unique
  genericCode      String?
  supplierRole     SupplierRole?
  leadTimeDays     Int?
  minimumOrder     Float?
  logisticsSummary String?
  financingSummary String?
  /** Validado por el equipo de ATAR: habilita el sello en la ficha. */
  isVerified       Boolean  @default(false)
  about            String?
  foundedYear      Int?
  /** Rango, no numero exacto: "51 - 200". */
  employeeRange    String?
  certifications   String[]
  mainProducts     String[]
  capabilities     String[]
  categories       String[]
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model RequestCatalogCategory {
  id             String                    @id @default(cuid())
  label          String                    @unique
  subtitle       String?
  imageSrc       String?
  imageClassName String?
  searchKeywords String[]
  sortOrder      Int                       @default(0)
  isActive       Boolean                   @default(true)
  fields         RequestCatalogField[]
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([isActive, sortOrder])
}

model RequestCatalogField {
  id          String                  @id @default(cuid())
  categoryId  String
  key         String
  label       String
  type        RequestCatalogFieldType
  options     String[]
  placeholder String?
  helper      String?
  required    Boolean                 @default(false)
  fullWidth   Boolean                 @default(false)
  inputType   RequestCatalogInputType?
  sortOrder   Int                     @default(0)
  isActive    Boolean                 @default(true)
  category    RequestCatalogCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@unique([categoryId, key])
  @@index([categoryId, isActive, sortOrder])
}

model Request {
  id             String        @id @default(cuid())
  buyerCompanyId String
  awardedQuoteId String?       @unique
  title          String
  productName    String?
  description    String
  category       String
  quantityRequested Int?
  referenceUnitPrice Float?
  estimatedTotalCost Float?
  preferredSupplierName String?
  status         RequestStatus @default(DRAFT)
  privateRequest Boolean       @default(false)
  dueDate        DateTime?
  // Entrega estructurada (antes se aplanaba dentro de `description` y se
  // re-parseaba por regex). Todo opcional: la UI muestra lo que este cargado.
  deliveryMode        String?   // asap | exact | range
  deliveryAddress     String?
  deliveryCity        String?
  deliveryProvince    String?
  deliveryContactName String?
  deliveryPhone       String?
  deliverySchedule    String?
  deliveryNotes       String?
  buyerCompany   Company       @relation("BuyerRequests", fields: [buyerCompanyId], references: [id], onDelete: Cascade)
  awardedQuote   Quote?        @relation("AwardedRequestQuote", fields: [awardedQuoteId], references: [id])
  conversations  Conversation[]
  events         RequestEvent[]
  order          PurchaseOrder?
  quotes         Quote[]       @relation("RequestQuotes")
  assignments    RequestAssignment[]
  items          RequestItem[]
  targetSuppliers RequestTargetSupplier[]
  billingCommissions BillingCommission[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([buyerCompanyId])
  @@index([status])
}

// Destinatarios de una solicitud privada, por ID de empresa (no por nombre).
// Reemplaza el match por string de `preferredSupplierName`, que era fragil y
// permitia fugas entre empresas homonimas. `preferredSupplierName` se conserva
// para compatibilidad/visualizacion y como fallback de solicitudes viejas.
model RequestTargetSupplier {
  id                String   @id @default(cuid())
  requestId         String
  supplierCompanyId String
  request           Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  supplierCompany   Company  @relation("RequestTargets", fields: [supplierCompanyId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  @@unique([requestId, supplierCompanyId])
  @@index([supplierCompanyId])
}

// Bandeja comercial de una empresa proveedora sobre una solicitud concreta.
// Guarda a quien esta asignada (vendedor) y en que etapa del pipeline esta.
model RequestAssignment {
  id                String            @id @default(cuid())
  requestId         String
  supplierCompanyId String
  sellerUserId      String?
  status            OpportunityStatus @default(NEW)
  assignedAt        DateTime?
  assignedByUserId  String?
  notes             String?
  lastSellerViewAt  DateTime?
  request           Request           @relation(fields: [requestId], references: [id], onDelete: Cascade)
  supplierCompany   Company           @relation("SupplierAssignments", fields: [supplierCompanyId], references: [id], onDelete: Cascade)
  seller            User?             @relation("SellerAssignments", fields: [sellerUserId], references: [id], onDelete: SetNull)
  assignedBy        User?             @relation("AssignedByUser", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([requestId, supplierCompanyId])
  @@index([supplierCompanyId, status])
  @@index([sellerUserId, status])
  @@index([requestId])
}

model Quote {
  id                String      @id @default(cuid())
  requestId         String
  supplierCompanyId String
  amount            Float?
  currency          String      @default("ARS")
  leadTimeDays      Int?
  paymentTerms      String?
  // Validez de la oferta y pedido mínimo, estructurados (antes iban como texto
  // libre dentro de technicalComment y no se podían comparar ni vencer).
  validUntil        DateTime?
  minimumOrder      Float?
  technicalComment  String?
  status            QuoteStatus @default(DRAFT)
  awardedForRequest Request?    @relation("AwardedRequestQuote")
  conversations     Conversation[]
  items             QuoteItem[]
  revisions         QuoteRevision[]
  billingCommissions BillingCommission[]
  request           Request     @relation("RequestQuotes", fields: [requestId], references: [id], onDelete: Cascade)
  supplierCompany   Company     @relation("SupplierQuotes", fields: [supplierCompanyId], references: [id], onDelete: Cascade)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([requestId])
  @@index([supplierCompanyId])
}

// Historial de versiones de una cotizacion (negociacion). Cada envio/edicion
// del proveedor guarda un snapshot, para que el comprador vea "que se ofrecio,
// que cambio y cual es la version vigente" sin depender solo del chat.
model QuoteRevision {
  id               String   @id @default(cuid())
  quoteId          String
  version          Int
  amount           Float?
  currency         String   @default("ARS")
  leadTimeDays     Int?
  paymentTerms     String?
  technicalComment String?
  quote            Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())

  @@unique([quoteId, version])
  @@index([quoteId])
}

// Linea de una solicitud: un producto concreto pedido (con su cantidad y
// specs). Una solicitud puede pedir varios productos al mismo proveedor.
model RequestItem {
  id                 String      @id @default(cuid())
  requestId          String
  position           Int         @default(0)
  productName        String
  category           String?
  quantity           Int?
  unit               String?
  specifications     String?
  referenceUnitPrice Float?
  request            Request     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  quoteItems         QuoteItem[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([requestId])
}

// Linea de una cotizacion: el precio unitario que el proveedor ofrece para un
// RequestItem. El total de la cotizacion es la suma de cantidad x precioUnit.
// Disponibilidad que declara el vendedor para cada producto cotizado.
enum QuoteItemAvailability {
  QUOTED // lo cotiza normalmente
  UNAVAILABLE // no lo tiene / no lo ofrece
  ALTERNATIVE // ofrece un reemplazo (detalle en note)
}

model QuoteItem {
  id            String                @id @default(cuid())
  quoteId       String
  requestItemId String
  availability  QuoteItemAvailability  @default(QUOTED)
  // Null cuando el producto no esta disponible. Para ALTERNATIVE es el precio
  // del reemplazo ofrecido.
  unitPrice     Float?
  // Nota del vendedor: detalle del reemplazo, motivo del faltante o consejo.
  note          String?
  quote         Quote                 @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  requestItem   RequestItem           @relation(fields: [requestItemId], references: [id], onDelete: Cascade)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([quoteId, requestItemId])
  @@index([quoteId])
  @@index([requestItemId])
}

model RequestEvent {
  id               String           @id @default(cuid())
  requestId        String
  type             RequestEventType
  title            String
  detail           String?
  actorRole        MembershipRole?
  actorCompanyName String?
  request          Request          @relation(fields: [requestId], references: [id], onDelete: Cascade)
  createdAt        DateTime         @default(now())

  @@index([requestId, createdAt])
}

model PurchaseOrder {
  id                String                 @id @default(cuid())
  requestId         String                 @unique
  orderNumber       String                 @unique
  fulfillmentStatus OrderFulfillmentStatus @default(ISSUED)
  issuedAt          DateTime               @default(now())
  promisedDate      DateTime?
  notes             String?
  request           Request                @relation(fields: [requestId], references: [id], onDelete: Cascade)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
}

model Conversation {
  id                 String                  @id @default(cuid())
  requestId          String?
  quoteId            String?
  contextType        ConversationContextType
  contextTitle       String
  buyerCompanyId     String
  supplierCompanyId  String
  lastMessageAt      DateTime?
  request            Request?                @relation(fields: [requestId], references: [id], onDelete: Cascade)
  quote              Quote?                  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  messages           ConversationMessage[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([buyerCompanyId, lastMessageAt])
  @@index([supplierCompanyId, lastMessageAt])
  @@index([requestId])
  @@index([quoteId])
  @@unique([quoteId, supplierCompanyId])
}

model ConversationMessage {
  id                     String         @id @default(cuid())
  conversationId         String
  senderUserId           String
  senderRole             MembershipRole
  senderCompanyName      String?
  body                   String
  attachmentName         String?
  attachmentMimeType     String?
  attachmentSize         Int?
  attachmentBase64       String?
  emailNotificationQueuedAt DateTime?
  buyerReadAt            DateTime?
  supplierReadAt         DateTime?
  conversation           Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt              DateTime       @default(now())

  @@index([conversationId, createdAt])
}

model Notification {
  id          String                  @id @default(cuid())
  userId      String
  companyId   String
  type        NotificationType
  title       String
  detail      String?
  href        String?
  metadata    Json?
  readAt      DateTime?
  emailStatus NotificationEmailStatus @default(PENDING)
  emailSentAt DateTime?
  emailError  String?
  user        User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([companyId, createdAt])
  @@index([type, createdAt])
}

model PushEndpoint {
  id         String      @id @default(cuid())
  userId     String
  companyId  String
  channel    PushChannel
  endpoint   String      @unique
  payload    Json?
  userAgent  String?
  deviceName String?
  isActive   Boolean     @default(true)
  lastSeenAt DateTime    @default(now())
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, channel, isActive])
  @@index([companyId, channel, isActive])
}

// ============================================================================
// BILLING / COMISIONES  (ver docs/billing/README.md)
// Dominio aislado: Operacion (Request) != Comision != Liquidacion != Pago.
// La comision se genera cuando una operacion se cierra (Request -> COMPLETED).
// ============================================================================

enum BillingPayer {
  SUPPLIER // proveedor adjudicado (default: success fee sobre la venta ganada)
  BUYER
}

enum CommissionType {
  SUCCESS_FEE
}

enum CommissionStatus {
  PENDING    // identificada al cerrar la operacion
  CONFIRMED  // confirmada (lista para liquidar)
  INVOICED   // incluida en una liquidacion
  PAID
  VOID       // anulada (antes de liquidar)
  ADJUSTED   // corregida via ajuste
}

enum BillingPeriodStatus {
  OPEN
  PROCESSING
  GENERATED
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CLOSED
  CANCELLED
}

enum SettlementStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum BillingPaymentMethod {
  MANUAL_TRANSFER
  MERCADOPAGO
}

enum BillingPaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
  REFUNDED
}

enum BillingAdjustmentType {
  CREDIT
  DEBIT
  VOID
  REFUND
  CORRECTION
}

// Regla de comision, versionada. Cambiar el % crea una nueva version vigente;
// las comisiones ya calculadas conservan su snapshot (no se recalculan).
model BillingRule {
  id             String         @id @default(cuid())
  version        Int            @default(1)
  label          String
  payer          BillingPayer   @default(SUPPLIER)
  commissionType CommissionType @default(SUCCESS_FEE)
  ratePercent    Float?         // 1.0 = 1%
  fixedAmount    Float?
  minAmount      Float?
  maxAmount      Float?
  currency       String?        // null = aplica a todas las monedas
  scopeCompanyId String?        // null = global
  scopeCategory  String?
  effectiveFrom  DateTime       @default(now())
  effectiveTo    DateTime?
  isActive       Boolean        @default(true)
  createdByUserId String?
  commissions    BillingCommission[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([isActive, effectiveFrom])
  @@index([scopeCompanyId])
}

// Comision de UNA operacion. unique(requestId, commissionType) => 1 operacion
// genera 0 o 1 comision principal (idempotencia).
model BillingCommission {
  id                  String           @id @default(cuid())
  companyId           String           // empresa que PAGA (segun payer)
  requestId           String
  quoteId             String
  ruleId              String
  ruleVersion         Int
  commissionType      CommissionType   @default(SUCCESS_FEE)
  payer               BillingPayer
  baseAmount          Float
  ratePercentSnapshot Float?
  fixedAmountSnapshot Float?
  commissionAmount    Float
  currency            String
  status              CommissionStatus @default(PENDING)
  periodId            String?
  settlementId        String?
  generatedAt         DateTime         @default(now())
  confirmedAt         DateTime?
  voidedAt            DateTime?
  paidAt              DateTime?
  metadata            Json?
  company             Company            @relation(fields: [companyId], references: [id])
  request             Request            @relation(fields: [requestId], references: [id])
  quote               Quote              @relation(fields: [quoteId], references: [id])
  rule                BillingRule        @relation(fields: [ruleId], references: [id])
  period              BillingPeriod?     @relation(fields: [periodId], references: [id])
  settlement          BillingSettlement? @relation(fields: [settlementId], references: [id])
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([requestId, commissionType])
  @@index([companyId, status])
  @@index([periodId])
  @@index([settlementId])
  @@index([status, currency])
}

// Periodo mensual de liquidacion (global). Las liquidaciones por empresa
// cuelgan de aca.
model BillingPeriod {
  id          String              @id @default(cuid())
  code        String              @unique // "2026-09"
  startsAt    DateTime
  endsAt      DateTime
  status      BillingPeriodStatus @default(OPEN)
  generatedAt DateTime?
  closedAt    DateTime?
  dueAt       DateTime?
  settlements BillingSettlement[]
  commissions BillingCommission[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

// Liquidacion de una empresa en un periodo y moneda. Unidad que la empresa ve
// y paga. unique(periodId, companyId, currency) => re-ejecutar no duplica.
model BillingSettlement {
  id               String           @id @default(cuid())
  periodId         String
  companyId        String
  currency         String
  payer            BillingPayer
  operationsCount  Int              @default(0)
  baseTotal        Float            @default(0)
  commissionTotal  Float            @default(0)
  adjustmentsTotal Float            @default(0)
  grandTotal       Float            @default(0)
  status           SettlementStatus @default(DRAFT)
  documentNumber   String           @unique
  issuedAt         DateTime?
  dueAt            DateTime?
  paidAt           DateTime?
  voidedAt         DateTime?
  // Dedupe de recordatorios (Fase 8): se setean una sola vez cuando se avisa.
  dueSoonNotifiedAt DateTime?
  overdueNotifiedAt DateTime?
  period           BillingPeriod       @relation(fields: [periodId], references: [id], onDelete: Cascade)
  company          Company             @relation(fields: [companyId], references: [id])
  commissions      BillingCommission[]
  adjustments      BillingAdjustment[]
  payments         BillingPayment[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([periodId, companyId, currency])
  @@index([companyId, status])
  @@index([status])
}

// Ajuste sobre una liquidacion/comision. Nunca se edita un monto historico:
// toda correccion es un ajuste con trazabilidad.
model BillingAdjustment {
  id             String                @id @default(cuid())
  settlementId   String
  commissionId   String?
  type           BillingAdjustmentType
  amount         Float
  currency       String
  reason         String
  note           String?
  previousAmount Float?
  newAmount      Float?
  createdByUserId String?
  settlement     BillingSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  createdAt      DateTime          @default(now())

  @@index([settlementId])
}

// Pago de una liquidacion. Confirmacion SIEMPRE server-side (webhook o
// aprobacion admin del manual). Nunca por retorno del frontend.
model BillingPayment {
  id                 String               @id @default(cuid())
  settlementId       String
  method             BillingPaymentMethod
  status             BillingPaymentStatus @default(PENDING)
  amount             Float
  currency           String
  externalReference  String               @unique
  providerPaymentId  String?
  receiptUrl         String?
  registeredByUserId String?
  confirmedByUserId  String?
  paidAt             DateTime?
  confirmedAt        DateTime?
  rejectedAt         DateTime?
  metadata           Json?
  settlement         BillingSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([settlementId, status])
}

// Idempotencia de webhooks: un mismo evento no se procesa dos veces.
model BillingWebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String
  payload     Json
  status      String   @default("RECEIVED") // RECEIVED | PROCESSED | IGNORED | ERROR
  processedAt DateTime?
  createdAt   DateTime @default(now())

  @@unique([provider, eventId])
}

// Auditoria de acciones administrativas relevantes.
model BillingAuditLog {
  id            String   @id @default(cuid())
  actorUserId   String?
  action        String
  entity        String
  entityId      String
  previousValue Json?
  newValue      Json?
  reason        String?
  createdAt     DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// Configuracion de negocio editable sin tocar codigo (fila unica, key = "default").
model BillingSettings {
  id                     String   @id @default("default")
  isEnabled              Boolean  @default(true)
  generationDayOfMonth   Int      @default(1)
  dueDays                Int      @default(15)
  defaultRuleId          String?
  paymentProviderDefault BillingPaymentMethod @default(MANUAL_TRANSFER)
  updatedAt              DateTime @updatedAt
}
